+void VulkanCommandProcessor::BeginIndependentClearPair(
+    VkRenderPass render_pass, const VulkanRenderTargetCache::Framebuffer* framebuffer,
+    VkImageView depth_view, VkImageView color_view) {
+  // End the previous scope before selecting different attachment views.
+  EndRenderPass();
+  SubmitBarriers(false);
+  const bool dynamic = REXCVAR_GET(vulkan_dynamic_rendering) &&
+      GetVulkanDevice()->properties().dynamicRendering;
+  if (!dynamic) {
+    SubmitBarriersAndEnterRenderTargetCacheRenderPass(render_pass, framebuffer);
+    return;
+  }
+  VkRenderingAttachmentInfo color = {};
+  color.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+  color.imageView = color_view;
+  color.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  color.resolveMode = VK_RESOLVE_MODE_NONE;
+  color.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+  color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+  VkRenderingAttachmentInfo depth = color;
+  depth.imageView = depth_view;
+  depth.imageLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+  VkRenderingInfo info = {};
+  info.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
+  info.renderArea.extent = framebuffer->host_extent;
+  info.layerCount = 1;
+  info.colorAttachmentCount = 1;
+  info.pColorAttachments = &color;
+  info.pDepthAttachment = &depth;
+  info.pStencilAttachment = &depth;
+  deferred_command_buffer_.CmdVkBeginRendering(&info);
+  current_render_pass_ = VK_NULL_HANDLE;
+  current_framebuffer_ = framebuffer;
+  in_render_pass_ = true;
+}
