+void GrfsSaveDriverCache(const ui::vulkan::VulkanDevice* device,GrfsWarmCache& s,bool force=false){
+  if(s.cache==VK_NULL_HANDLE)return;
+  std::lock_guard<std::mutex> lock(s.lock);
+  const auto now=std::chrono::steady_clock::now();
+  if(!force && now-s.saved<std::chrono::seconds(1))return;
+  s.saved=now;size_t size=0;
+  auto& f=device->functions();
+  if(s.get(device->device(),s.cache,&size,nullptr)!=VK_SUCCESS || size>256*1024*1024 || size<32)return;
+  std::vector<uint8_t> bytes(size);
+  if(s.get(device->device(),s.cache,&size,bytes.data())!=VK_SUCCESS)return;
+  auto tmp=s.path;tmp+=".tmp";
+  if(FILE*out=std::fopen(tmp.c_str(),"wb")){
+    const bool ok=std::fwrite(bytes.data(),1,size,out)==size;std::fclose(out);
+    if(ok){std::error_code ec;std::filesystem::rename(tmp,s.path,ec);}
+  }
+}
+void GrfsInitDriverCache(const VulkanPipelineCache* owner,const ui::vulkan::VulkanDevice* device,const std::filesystem::path& root){
