+  }
+  VkPhysicalDeviceProperties props{};
+  device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(device->physical_device(),&props);
+  if(!bytes.empty()){
+    uint32_t header[4];std::memcpy(header,bytes.data(),16);
+    if(header[0]<32 || header[0]>bytes.size() || header[1]!=VK_PIPELINE_CACHE_HEADER_VERSION_ONE ||
