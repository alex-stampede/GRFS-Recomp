+    spvtools::Optimizer optimizer(SPV_ENV_VULKAN_1_2);
+    optimizer.SetMessageConsumer([](spv_message_level_t, const char*, const spv_position_t&, const char* message) {
+      REXGPU_WARN("[GRFS SPIRV OPT] {}", message);
+    });
+    optimizer.RegisterPerformancePasses(true); // Preserve stage interfaces.
+    spvtools::ValidatorOptions validation_options;
+    validation_options.SetScalarBlockLayout(vulkan_device->properties().scalarBlockLayout);
+    validation_options.SetUniformBufferStandardLayout(vulkan_device->properties().uniformBufferStandardLayout);
+    spvtools::OptimizerOptions options;
+    options.set_validator_options(validation_options);
+    options.set_preserve_bindings(true);
+    options.set_preserve_spec_constants(true);
+    const bool ok = optimizer.Run(shader_module_create_info.pCode,
