+      if (validator.Validate(optimized.data(), optimized.size(), validation_options)) {
+        shader_module_create_info.codeSize = optimized.size() * sizeof(uint32_t);
+        shader_module_create_info.pCode = optimized.data();
+        if (const char* directory = std::getenv("GRFS_SPIRV_OPT_DUMP")) {
+          std::error_code error;
+          std::filesystem::create_directories(directory, error);
+          if (!error) {
+            std::ofstream f(std::filesystem::path(directory) / fmt::format("{:016X}-{:016X}.spv", shader().ucode_data_hash(), modification()), std::ios::binary);
+            f.write(reinterpret_cast<const char*>(optimized.data()), shader_module_create_info.codeSize);
+          }
+        }
+        REXGPU_INFO("[GRFS SPIRV OPT] hash={:016X} mod={:016X} bytes={} -> {} ms={:.2f}",
+            shader().ucode_data_hash(), modification(), translated_binary().size(),
+            shader_module_create_info.codeSize, std::chrono::duration<double,std::milli>(
+              std::chrono::steady_clock::now()-start).count());
+      } else REXGPU_WARN("[GRFS SPIRV OPT] validation failed; original module retained");
+    } else REXGPU_WARN("[GRFS SPIRV OPT] optimization failed; original module retained");
+  }
   if (vulkan_device->functions().vkCreateShaderModule(vulkan_device->device(),
                                                       &shader_module_create_info, nullptr,
                                                       &shader_module_) != VK_SUCCESS) {
